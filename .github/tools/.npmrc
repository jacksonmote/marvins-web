# CI-only tools: never run package install scripts (preinstall, install,
# postinstall, prepare). The workflows also pass --ignore-scripts and set
# npm_config_ignore_scripts, so all three would have to be removed to run one.
ignore-scripts=true
# When a version is changed with npm install, save it exactly (no ^ range)
# and update package-lock.json with it.
save-exact=true
package-lock=true
# No funding or update notices in CI logs.
fund=false
update-notifier=false
